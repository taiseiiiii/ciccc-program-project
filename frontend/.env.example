# Copy to .env.local (gitignored) and fill in.
# See SUPABASE_SETUP.md for where these values come from.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (formerly "anon" key) — safe to expose in the browser.
# Never put the secret / service_role key here.
VITE_SUPABASE_ANON_KEY=

# Base URL of the Express API.
VITE_API_URL=http://localhost:4000/api/v1

# Sentry DSN for browser error reporting. Optional: without it nothing is sent,
# and reporting is production-only regardless. Project type: React.
VITE_SENTRY_DSN=
