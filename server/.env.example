# Server
PORT=4000
NODE_ENV=development

# CORS: comma-separated list of allowed origins (frontend URLs)
# 5173 is the Vite dev server default.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/climb_app

# Supabase Auth (required)
# Project URL from the Supabase dashboard, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Optional: only for legacy Supabase projects whose access tokens are signed
# with HS256 (dashboard -> Settings -> API -> JWT Secret). Leave unset to
# verify tokens against the project's public JWKS endpoint (the default for
# projects using asymmetric signing keys).
SUPABASE_JWT_SECRET=
