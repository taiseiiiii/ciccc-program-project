# Server
PORT=4000
NODE_ENV=development

# CORS: comma-separated list of allowed origins (frontend URLs)
# 5173 is the Vite dev server default. Set this to the deployed frontend origin
# in production.
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local Postgres:
#   Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/climb_app

# Hosted on Supabase — press "Connect" at the top of the project dashboard.
# Three strings are offered; pick by network, not by preference:
#   * Direct connection (db.<project-ref>.supabase.co:5432) — a real Postgres
#     connection. Best for a long-lived Express process and for migrations.
#     The host is IPv6-only unless the IPv4 add-on is enabled, so it fails from
#     IPv4-only networks and from hosting platforms without IPv6.
#   * Session pooler (aws-<region>.pooler.supabase.com:5432, user
#     postgres.<project-ref>) — the IPv4-friendly stand-in for a direct
#     connection. Session-level features still work, so migrations are fine.
#   * Transaction pooler (same host, port 6543) — for serverless/edge runtimes.
#     No session-level state, so advisory locks are not held across statements:
#     do NOT run `db:migrate` through it.
# [YOUR-PASSWORD] is the database password chosen when the project was created
# (not the publishable/anon key). It is not visible to invited members — ask the
# project owner, or reset it from the Database settings.
#
#   DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# TLS for the database connection: auto | require | no-verify | disable
#   auto      (default) off for localhost, verified TLS for any other host
#   require   verified TLS — fails if the certificate chain is not trusted
#   no-verify TLS without certificate checks. Encrypts but cannot detect a
#             man-in-the-middle — local debugging only, never production
#   disable   plaintext
# Leave unset unless a hosted database rejects the default.
# DATABASE_SSL=auto

# CA bundle, needed when the host's chain is not in the system trust store.
# Supabase signs Postgres certificates with its own "Supabase Root 2021 CA", so
# connecting to it without this fails with:
#   self-signed certificate in certificate chain
# Download prod-ca-2021.crt from the dashboard (Database settings -> SSL
# configuration) and point at it. The value may be either a path — relative ones
# resolve from the server/ directory — or the PEM text itself, which is what to
# use on hosts that offer environment variables but no writable filesystem
# (escaped \n newlines are accepted there).
# DATABASE_CA_CERT=./certs/prod-ca-2021.crt

# -----------------------------------------------------------------------------
# Supabase Auth (required — the server refuses to start without SUPABASE_URL)
# -----------------------------------------------------------------------------
# Project URL from the Supabase dashboard, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Optional: only for legacy Supabase projects whose access tokens are signed
# with HS256 (dashboard -> Settings -> API -> JWT Secret). Leave unset to
# verify tokens against the project's public JWKS endpoint (the default for
# projects using asymmetric signing keys). To check which applies, run:
#   curl -s https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# A non-empty "keys" array means you can leave this unset.
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# OpenAI (AI analysis)
# -----------------------------------------------------------------------------
# API key from https://platform.openai.com/api-keys. Optional: without it the
# server still runs, but the AI endpoints (/performances, /trainings) answer
# 503. Never commit a real key.
OPENAI_API_KEY=

# Model used for analysis. Defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o
